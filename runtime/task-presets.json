{
  "refresh-default": {
    "command": "refresh-environment",
    "description": "默认环境刷新模板。",
    "profile": "maintenance",
    "api_profile": "safe_read",
    "options": {
      "market": "AG",
      "force": false
    }
  },
  "guarded-default": {
    "command": "guarded-trade-buy",
    "description": "受保护买入模板，固定串口和 workflow 环境参数，保留 code/price/quantity 动态输入。",
    "profile": "guarded_trade_buy",
    "api_profile": "safe_read",
    "trade_profile": "balanced",
    "options": {
      "port": "COM3",
      "baudrate": 115200,
      "timeout": 2.0,
      "max_depth": 12,
      "close_result_dialog": true
    }
  },
  "task-buy-default": {
    "command": "trade-buy",
    "description": "常规 task 买入模板。",
    "profile": "trade_buy",
    "api_profile": "safe_read",
    "trade_profile": "balanced",
    "options": {
      "port": "COM3",
      "baudrate": 115200,
      "timeout": 2.0,
      "max_depth": 12,
      "close_result_dialog": true
    }
  },
  "task-sell-default": {
    "command": "trade-sell",
    "description": "常规 task 卖出模板。",
    "profile": "trade_sell",
    "api_profile": "safe_read",
    "trade_profile": "balanced",
    "options": {
      "port": "COM3",
      "baudrate": 115200,
      "timeout": 2.0,
      "max_depth": 12,
      "close_result_dialog": true
    }
  },
  "submit-once-default": {
    "command": "trade-submit-once",
    "description": "完整提交 task 模板。",
    "profile": "trade_submit_once",
    "api_profile": "safe_read",
    "trade_profile": "submit_once",
    "options": {
      "port": "COM3",
      "baudrate": 115200,
      "timeout": 2.0,
      "max_depth": 12,
      "close_result_dialog": true
    }
  },
  "submit-ready-default": {
    "command": "trade-submit-ready",
    "description": "分步提交前边界 task 模板，固定串口和 workflow 环境参数。",
    "profile": "trade_submit_ready",
    "api_profile": "safe_read",
    "trade_profile": "balanced",
    "options": {
      "port": "COM3",
      "baudrate": 115200,
      "timeout": 2.0,
      "max_depth": 12
    }
  },
  "confirm-current-default": {
    "command": "trade-confirm-current",
    "description": "推进当前确认框并回到主界面的 task 模板。",
    "profile": "trade_confirm_current",
    "api_profile": "safe_read",
    "trade_profile": "balanced",
    "options": {
      "close_result_dialog": true
    }
  },
  "export-zxg-watchlist": {
    "command": "block-read-watchlist-export",
    "description": "导出 ZXG 自选板块快照到固定 JSON 文件。",
    "profile": "default",
    "api_profile": "safe_read",
    "options": {
      "block_code": "ZXG",
      "export_output": "runtime/exports/zxg.json",
      "overwrite": false
    }
  },
  "plan-zxg-block-sync-merge": {
    "command": "block-sync",
    "description": "使用显式 merge_dry_run 写策略生成 ZXG 自选板块同步计划。",
    "profile": "default",
    "api_profile": "safe_read",
    "options": {
      "block_code": "ZXG",
      "stock": [
        "000001.SZ",
        "600519.SH"
      ],
      "write_policy": "merge_dry_run",
      "dry_run": true,
      "show": true
    }
  },
  "plan-zxg-watchlist-import": {
    "command": "block-watchlist-import",
    "description": "从固定 JSON 文件生成 ZXG 自选板块导入 dry-run 计划。",
    "profile": "default",
    "api_profile": "safe_read",
    "options": {
      "input_path": "runtime/watchlist-imports/zxg-watchlist-import.example.json",
      "dry_run": true,
      "show": true
    }
  },
  "read-zxg-watchlist": {
    "command": "block-read-watchlist",
    "description": "读取 ZXG 板块标准化快照。",
    "api_profile": "safe_read",
    "options": {
      "block_code": "ZXG"
    }
  },
  "read-zxg-full": {
    "command": "block-read-full",
    "description": "读取 ZXG 板块完整诊断视图。",
    "options": {
      "block_code": "ZXG"
    }
  }
}
