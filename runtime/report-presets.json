{
  "daily-review": {
    "command": "daily",
    "description": "当日交易日报，保留最近 20 条成交明细。",
    "profile": "daily_trade_report",
    "options": {
      "timezone": "Asia/Shanghai",
      "recent_limit": 20
    }
  },
  "daily-success": {
    "command": "daily",
    "description": "当日成功成交日报。",
    "profile": "daily_trade_report",
    "options": {
      "timezone": "Asia/Shanghai",
      "recent_limit": 20,
      "trade_ok": true
    }
  },
  "recent-ledger": {
    "command": "ledger",
    "description": "最近 20 笔台账摘要。",
    "profile": "ledger_summary",
    "options": {
      "limit": 20
    }
  },
  "recent-failures": {
    "command": "ledger",
    "description": "最近失败订单台账摘要。",
    "profile": "ledger_summary",
    "options": {
      "limit": 20,
      "trade_ok": false
    }
  },
  "period-review": {
    "command": "period",
    "description": "区间复盘模板，适合配合 --start-date/--end-date 覆盖日期范围。",
    "profile": "trade_period_report",
    "options": {
      "timezone": "Asia/Shanghai",
      "recent_limit": 50
    }
  },
